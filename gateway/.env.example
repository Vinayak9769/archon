# Core Gateway Configurations
PORT=8080
DATABASE_URL=postgres://postgres:password@localhost:5432/archon?sslmode=disable
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=generate_a_secure_jwt_secret_key_here
AI_SERVICE_URL=localhost:50051

# Frontend Redirect Endpoint
FRONTEND_URL=http://localhost:3000

# GitHub App Integration
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback/github
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_APP_PRIVATE_KEY_PATH=path/to/private-key.pem
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
